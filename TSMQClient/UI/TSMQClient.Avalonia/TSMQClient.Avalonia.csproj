  <ItemGroup>
    <ProjectReference Include="..\..\Core\TSMQClient.Mvvm\TSMQClient.Mvvm.csproj" />
    <ProjectReference Include="..\..\Modules\TSMQClient.Remote.Module\TSMQClient.Remote.Module.csproj" />
  </ItemGroup>
