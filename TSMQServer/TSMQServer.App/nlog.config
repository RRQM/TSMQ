<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <targets>
    <!-- 按天分文件存储，文件名格式：logs/2024-01-01.log -->
    <target name="file"
            xsi:type="File"
            fileName="${basedir}/logs/${shortdate}.log"
            layout="${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}"
            encoding="utf-8"
            keepFileOpen="true"
            concurrentWrites="true" />

    <!-- 控制台输出 -->
    <target name="console"
            xsi:type="ColoredConsole"
            layout="${date:format=HH\:mm\:ss.fff} [${level:uppercase=true:padding=-5}] ${logger:shortName=true}  ${message}${onexception:inner=${newline}${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- 过滤掉 Microsoft 框架的大量 Debug 日志，只保留 Warning 以上 -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.*" maxlevel="Info" final="true" />
    <!-- 文件保留调试详情，控制台仅显示运行信息、警告和错误 -->
    <logger name="*" minlevel="Debug" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>

</nlog>
