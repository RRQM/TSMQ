<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <!-- 单文件发布设置 -->
		<!--<PublishSingleFile>true</PublishSingleFile>-->
		<!--<SelfContained>true</SelfContained>-->
		<!--<PublishTrimmed>false</PublishTrimmed>-->
		<!-- 如需发布为特定运行时，请取消注释并设置合适的 RID，例如 win-x64、linux-x64 -->
		<!-- <RuntimeIdentifier>win-x64</RuntimeIdentifier> -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
		<PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
		<PackageReference Include="TouchSocket.Hosting" Version="4.3.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TSMQServer.Core.Imp\TSMQServer.Core.Imp.csproj" />
		<ProjectReference Include="..\TSMQServer.Db.Sqlite\TSMQServer.Db.Sqlite.csproj" />
		<ProjectReference Include="..\TSMQServer.Db\TSMQServer.Db.csproj" />
		<ProjectReference Include="..\TSMQServer.Web\TSMQServer.Web.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="nlog.config">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<!-- Windows 服务管理脚本：仅在目标为 Windows 时才包含 -->
	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform(Windows)))">
	  <Content Include="create.bat">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Include="delete.bat">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Include="start.bat">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Include="stop.bat">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	</ItemGroup>

</Project>
